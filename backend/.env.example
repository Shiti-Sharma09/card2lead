# ---------------------------------------------------------------------------
# referral_card backend — configuration
# Copy this file to ".env" and fill in the values. ".env" is git-ignored.
# ---------------------------------------------------------------------------

# dev | prod | test   (prod = stricter CORS + refuses default JWT secret)
APP_ENV=dev

# SQLite file (relative to the backend/ folder). Nothing else supported yet.
DATABASE_URL=sqlite:///./app.db

# Secret used to sign login tokens. Generate a long random string for prod:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_DAYS=7

# First admin — created on first boot. If the account already exists, its
# password is kept in sync with this value (so this is also the recovery path).
ADMIN_EMAIL=card.admin@gmail.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Groq (Phase 4). Leave BLANK to run extraction in mock mode (sample data).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_MAX_PER_MIN=25
GROQ_MAX_PER_DAY=1000

# Google Sheets (Phase 5).
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/gsa.json
GOOGLE_SHEET_ID=

# How the Timestamp column is written.
TIMEZONE=Asia/Kolkata

# Comma-separated allow-list of browser origins. "*" is fine for local dev.
CORS_ORIGINS=*

# Email / SMTP (Phase 1 forgot-password + later thank-you email). Optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
