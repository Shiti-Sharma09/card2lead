# ---------------------------------------------------------------------------
# CARD2LEAD backend configuration
# Copy this file to ".env" and fill in the values.
# The app runs WITHOUT a key in "mock mode" (returns sample data) so you can
# test the whole flow before the Gemini key is ready.
# ---------------------------------------------------------------------------

# Google AI Studio key -> https://aistudio.google.com/apikey
# Leave BLANK to run in mock mode.
GEMINI_API_KEY=

# Vision model id. gemini-2.5-flash is fast + cheap + strong at English OCR.
# Fallback option: gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Give up on a single Gemini call after this many milliseconds (then 1 retry).
GEMINI_TIMEOUT_MS=30000

# Where the master Excel file is written.
# Relative paths are resolved against the backend/ folder.
EXCEL_PATH=data/leads_master.xlsx

# Comma-separated options for the "Assign" dropdown (extend later as needed).
ASSIGNEES=NITISH,HARSHAD

# Fields whose self-reported confidence is below this get an amber
# "please verify" flag on the review screen.
CONFIDENCE_THRESHOLD=95

# Backend sharpness gate (variance-of-Laplacian). Lower = more lenient.
# Tuned separately from the frontend value (different image scale).
BLUR_THRESHOLD=120

# CORS. "*" is fine for the single-user ngrok setup; lock down for real deploys.
CORS_ORIGINS=*

# Reject uploads larger than this (megabytes).
MAX_UPLOAD_MB=12
