# Frontend build-time config. Copy to ".env" only if you need to override.

# API location as seen by the browser.
# Keep "/api" when FastAPI serves the built frontend (the ngrok setup) or when
# using the Vite dev proxy.
VITE_API_BASE=/api

# Dev only: where `npm run dev` forwards /api calls.
VITE_API_PROXY=http://localhost:8000

# Optional: override the client-side blur/sharpness cutoff.
VITE_BLUR_THRESHOLD=120
