# Frontend build-time config. Copy to ".env" only if you need to override.

# Where the browser reaches the API.
# - Production: leave EMPTY — the same server serves the app and the API.
# - Local dev: leave EMPTY too — the Vite dev server proxies /auth, /events,
#   /me, /assignees to the backend (see VITE_API_PROXY below).
# Set an absolute URL only if the API is on a different origin.
VITE_API_BASE=

# Dev only: where `npm run dev` forwards the API paths.
VITE_API_PROXY=http://localhost:8000

# Optional: override the client-side camera blur/sharpness cutoff.
VITE_BLUR_THRESHOLD=120
